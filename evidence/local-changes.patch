diff --git a/grid_epoch/session.py b/grid_epoch/session.py
index 4802bf9..4a79a7e 100644
--- a/grid_epoch/session.py
+++ b/grid_epoch/session.py
@@ -97,6 +97,20 @@ class ProvisionSession:
         if reply != "OK":
             raise _stated_failure(reply, "地市进程没有记下销毁")
 
+    def reprovision(self, terminal) -> None:
+        record = self.kmc.registry[terminal.tid]
+        if record.destroyed:
+            raise ProtocolError("终端已销毁")
+        if record.revoked or record.released:
+            raise ProtocolError("已吊销终端不能重新灌装")
+        self.city.send(f"REPROVISION {terminal.tid}")
+        reply = self.city.read()
+        if not reply.startswith("REPROVISION "):
+            raise _stated_failure(reply, "地市进程没有封装管理种子")
+        blob = reply.split()[1]
+        if terminal._ask(f"REPROVISION {terminal.tid} {blob}") != "SAME":
+            raise ProtocolError("产线没有核对重新灌装的管理种子")
+
     def transfer(self, terminal, new_zone: int, new_local: int):
         if self.kmc.registry[terminal.tid].destroyed:
             raise ProtocolError("终端已销毁")
